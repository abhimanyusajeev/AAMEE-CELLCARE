generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BusinessSettings {
  id               Int      @id @default(1)
  gstEnabled       Boolean  @default(false)
  gstNumber        String?
  returnWindowDays Int      @default(15)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Branch {
  id                 String                 @id @default(cuid())
  name               String
  code               String                 @unique
  address            String
  phone              String?
  email              String?
  invoicePrefix      String
  isActive           Boolean                @default(true)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  auditLogs          AuditLog[]
  customerVisits     CustomerVisit[]
  emiTransactions    EMITransaction[]
  expenses           Expense[]
  inventoryItems     InventoryItem[]
  invoices           Invoice[]
  notificationOutbox NotificationOutbox[]
  payments           Payment[]
  purchases          Purchase[]
  repairInvoices     RepairInvoice[]
  repairs            RepairJob[]
  repairPayments     RepairPayment[]
  sales              Sale[]
  saleReturns        SaleReturn[]
  serialDevices      SerialDevice[]
  stockMovements     StockMovement[]
  stockTransfersFrom StockTransfer[]        @relation("StockTransferFrom")
  stockTransfersTo   StockTransfer[]        @relation("StockTransferTo")
  transactions       Transaction[]
  assignments        UserBranchAssignment[]
  whatsappMessages   WhatsAppMessage[]
}

model User {
  id                      String                 @id @default(cuid())
  name                    String
  email                   String?                @unique
  phone                   String?                @unique
  passwordHash            String
  role                    Role
  isActive                Boolean                @default(true)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  uploadedAttachments     Attachment[]           @relation("AttachmentUploadedBy")
  auditLogs               AuditLog[]
  customerVisits          CustomerVisit[]        @relation("CustomerVisitCreatedBy")
  createdExpenses         Expense[]              @relation("ExpenseCreatedBy")
  notificationsCreated    NotificationOutbox[]   @relation("NotificationCreatedBy")
  createdPurchases        Purchase[]             @relation("PurchaseCreatedBy")
  createdRepairs          RepairJob[]            @relation("RepairCreatedBy")
  repairTechnicianJobs    RepairJob[]            @relation("RepairTechnician")
  repairStatusChanges     RepairStatusHistory[]
  createdSales            Sale[]                 @relation("SaleCreatedBy")
  sessions                Session[]
  stockMovements          StockMovement[]        @relation("StockMovementCreatedBy")
  stockTransfersApproved  StockTransfer[]        @relation("StockTransferApprovedBy")
  stockTransfersReceived  StockTransfer[]        @relation("StockTransferReceivedBy")
  stockTransfersRequested StockTransfer[]        @relation("StockTransferRequestedBy")
  branchAssignments       UserBranchAssignment[]
  whatsappMessagesSent    WhatsAppMessage[]      @relation("WhatsAppSentBy")
}

model Session {
  id             String    @id @default(cuid())
  userId         String
  tokenHash      String    @unique
  lastActivityAt DateTime
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model UserBranchAssignment {
  id        String   @id @default(cuid())
  userId    String
  branchId  String
  createdAt DateTime @default(now())
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([branchId, userId])
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id          String           @id @default(cuid())
  name        String
  sku         String           @unique
  barcode     String?          @unique
  brand       String?
  productType ProductType
  categoryId  String
  description String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  attachments Attachment[]
  category    Category         @relation(fields: [categoryId], references: [id])
  variants    ProductVariant[]

  @@index([categoryId, isActive])
  @@index([productType, isActive])
  @@index([brand])
}

model ProductVariant {
  id                 String              @id @default(cuid())
  productId          String
  name               String
  purchasePrice      Decimal             @db.Decimal(12, 2)
  sellingPrice       Decimal             @db.Decimal(12, 2)
  discount           Decimal             @default(0) @db.Decimal(12, 2)
  unit               String              @default("PCS")
  reorderLevel       Int                 @default(0)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  inventoryItems     InventoryItem[]
  product            Product             @relation(fields: [productId], references: [id])
  purchaseItems      PurchaseItem[]
  repairParts        RepairPart[]
  saleItems          SaleItem[]
  serialDevices      SerialDevice[]
  stockMovements     StockMovement[]
  stockTransferItems StockTransferItem[]
  warrantyPolicies   WarrantyPolicy[]

  @@index([productId, isActive])
}

model WarrantyPolicy {
  id               String         @id @default(cuid())
  productVariantId String
  name             String
  durationDays     Int
  provider         String?
  terms            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])

  @@index([productVariantId])
}

model Customer {
  id               String            @id @default(cuid())
  name             String
  phone            String
  alternatePhone   String?
  email            String?
  address          String?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  visits           CustomerVisit[]
  emiTransactions  EMITransaction[]
  repairs          RepairJob[]
  sales            Sale[]
  returns          SaleReturn[]
  whatsappMessages WhatsAppMessage[]

  @@index([phone])
  @@index([name])
}

model CustomerVisit {
  id          String    @id @default(cuid())
  customerId  String?
  branchId    String
  type        String
  note        String?
  createdById String
  visitedAt   DateTime  @default(now())
  branch      Branch    @relation(fields: [branchId], references: [id])
  createdBy   User      @relation("CustomerVisitCreatedBy", fields: [createdById], references: [id])
  customer    Customer? @relation(fields: [customerId], references: [id])

  @@index([branchId, visitedAt])
  @@index([customerId, visitedAt])
}

model Supplier {
  id        String     @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  gstin     String?
  notes     String?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  purchases Purchase[]

  @@index([name])
}

model InventoryItem {
  id               String         @id @default(cuid())
  branchId         String
  productVariantId String
  quantity         Int            @default(0)
  reorderLevel     Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  branch           Branch         @relation(fields: [branchId], references: [id])
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])

  @@unique([productVariantId, branchId])
  @@index([branchId, quantity])
}

model StockMovement {
  id               String            @id @default(cuid())
  branchId         String
  productVariantId String
  quantity         Int
  type             StockMovementType
  referenceType    String?
  referenceId      String?
  note             String?
  createdById      String
  createdAt        DateTime          @default(now())
  branch           Branch            @relation(fields: [branchId], references: [id])
  createdBy        User              @relation("StockMovementCreatedBy", fields: [createdById], references: [id])
  productVariant   ProductVariant    @relation(fields: [productVariantId], references: [id])

  @@index([branchId, createdAt])
  @@index([productVariantId, createdAt])
  @@index([referenceId])
}

model StockTransfer {
  id            String              @id @default(cuid())
  fromBranchId  String
  toBranchId    String
  status        StockTransferStatus
  requestedById String
  approvedById  String?
  receivedById  String?
  requestedAt   DateTime            @default(now())
  approvedAt    DateTime?
  dispatchedAt  DateTime?
  receivedAt    DateTime?
  approvedBy    User?               @relation("StockTransferApprovedBy", fields: [approvedById], references: [id])
  fromBranch    Branch              @relation("StockTransferFrom", fields: [fromBranchId], references: [id])
  receivedBy    User?               @relation("StockTransferReceivedBy", fields: [receivedById], references: [id])
  requestedBy   User                @relation("StockTransferRequestedBy", fields: [requestedById], references: [id])
  toBranch      Branch              @relation("StockTransferTo", fields: [toBranchId], references: [id])
  items         StockTransferItem[]

  @@index([fromBranchId, status, requestedAt])
  @@index([toBranchId, status, requestedAt])
}

model StockTransferItem {
  id               String         @id @default(cuid())
  stockTransferId  String
  productVariantId String
  quantity         Int
  serialDeviceId   String?
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  serialDevice     SerialDevice?  @relation(fields: [serialDeviceId], references: [id], onDelete: Restrict)
  stockTransfer    StockTransfer  @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)

  @@index([stockTransferId])
  @@index([serialDeviceId])
}

model SerialDevice {
  id                 String              @id @default(cuid())
  branchId           String
  productVariantId   String
  imei1              String              @unique
  imei2              String?             @unique
  serialNumber       String?
  ram                String?
  storage            String?
  color              String?
  warrantyText       String?
  purchasePrice      Decimal?            @db.Decimal(12, 2)
  salePrice          Decimal?            @db.Decimal(12, 2)
  status             SerialDeviceStatus  @default(AVAILABLE)
  soldSaleId         String?
  soldAt             DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  emiTransactions    EMITransaction[]
  saleItems          SaleItem[]
  branch             Branch              @relation(fields: [branchId], references: [id])
  productVariant     ProductVariant      @relation(fields: [productVariantId], references: [id])
  soldSale           Sale?               @relation("SoldSerialDevice", fields: [soldSaleId], references: [id])
  stockTransferItems StockTransferItem[]

  @@index([branchId, status])
  @@index([productVariantId, status])
}

model Purchase {
  id            String         @id @default(cuid())
  branchId      String
  supplierId    String
  invoiceNumber String?
  subtotal      Decimal        @db.Decimal(12, 2)
  discount      Decimal        @default(0) @db.Decimal(12, 2)
  tax           Decimal        @default(0) @db.Decimal(12, 2)
  total         Decimal        @db.Decimal(12, 2)
  notes         String?
  createdById   String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  branch        Branch         @relation(fields: [branchId], references: [id])
  createdBy     User           @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  items         PurchaseItem[]

  @@index([branchId, createdAt])
  @@index([supplierId, createdAt])
}

model PurchaseItem {
  id               String         @id @default(cuid())
  purchaseId       String
  productVariantId String
  quantity         Int
  unitPrice        Decimal        @db.Decimal(12, 2)
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  purchase         Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
}

model Sale {
  id             String          @id @default(cuid())
  branchId       String
  customerId     String?
  createdById    String
  subtotal       Decimal         @db.Decimal(12, 2)
  discount       Decimal         @default(0) @db.Decimal(12, 2)
  tax            Decimal         @default(0) @db.Decimal(12, 2)
  total          Decimal         @db.Decimal(12, 2)
  status         SaleStatus      @default(COMPLETED)
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  emiTransaction EMITransaction?
  invoice        Invoice?
  payments       Payment[]
  branch         Branch          @relation(fields: [branchId], references: [id])
  createdBy      User            @relation("SaleCreatedBy", fields: [createdById], references: [id])
  customer       Customer?       @relation(fields: [customerId], references: [id])
  items          SaleItem[]
  returns        SaleReturn[]
  soldDevices    SerialDevice[]  @relation("SoldSerialDevice")

  @@index([branchId, createdAt])
  @@index([customerId, createdAt])
  @@index([createdById, createdAt])
}

model SaleItem {
  id                   String           @id @default(cuid())
  saleId               String
  productVariantId     String
  serialDeviceId       String?
  quantity             Int
  unitPrice            Decimal          @db.Decimal(12, 2)
  discountAmount       Decimal          @default(0) @db.Decimal(12, 2)
  taxAmount            Decimal          @default(0) @db.Decimal(12, 2)
  warrantyName         String?
  warrantyDurationDays Int?
  createdAt            DateTime         @default(now())
  productVariant       ProductVariant   @relation(fields: [productVariantId], references: [id])
  sale                 Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  serialDevice         SerialDevice?    @relation(fields: [serialDeviceId], references: [id], onDelete: Restrict)
  returnItems          SaleReturnItem[]

  @@index([saleId])
  @@index([productVariantId])
}

model Invoice {
  id            String        @id @default(cuid())
  branchId      String
  saleId        String        @unique
  invoiceNumber String
  status        InvoiceStatus @default(ISSUED)
  issuedAt      DateTime      @default(now())
  createdAt     DateTime      @default(now())
  branch        Branch        @relation(fields: [branchId], references: [id])
  sale          Sale          @relation(fields: [saleId], references: [id])

  @@unique([branchId, invoiceNumber])
  @@index([branchId, issuedAt])
}

model Payment {
  id              String          @id @default(cuid())
  branchId        String
  saleId          String?
  repairPaymentId String?         @unique
  amount          Decimal         @db.Decimal(12, 2)
  method          PaymentMethod
  status          PaymentStatus   @default(PENDING)
  reference       String?
  paidAt          DateTime?
  createdAt       DateTime        @default(now())
  emiTransaction  EMITransaction?
  branch          Branch          @relation(fields: [branchId], references: [id])
  repairPayment   RepairPayment?  @relation(fields: [repairPaymentId], references: [id])
  sale            Sale?           @relation(fields: [saleId], references: [id])

  @@index([branchId, createdAt])
  @@index([saleId, createdAt])
  @@index([method, createdAt])
}

model SaleReturn {
  id           String           @id @default(cuid())
  branchId     String
  saleId       String
  customerId   String?
  status       ReturnStatus     @default(REQUESTED)
  reason       String?
  refundAmount Decimal          @default(0) @db.Decimal(12, 2)
  createdAt    DateTime         @default(now())
  processedAt  DateTime?
  branch       Branch           @relation(fields: [branchId], references: [id])
  customer     Customer?        @relation(fields: [customerId], references: [id])
  sale         Sale             @relation(fields: [saleId], references: [id])
  items        SaleReturnItem[]

  @@index([branchId, createdAt])
  @@index([saleId])
}

model SaleReturnItem {
  id           String     @id @default(cuid())
  saleReturnId String
  saleItemId   String
  quantity     Int
  refundAmount Decimal    @default(0) @db.Decimal(12, 2)
  saleItem     SaleItem   @relation(fields: [saleItemId], references: [id])
  saleReturn   SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)

  @@index([saleReturnId])
  @@index([saleItemId])
}

model RepairJob {
  id             String                @id @default(cuid())
  branchId       String
  customerId     String?
  ticketNumber   String
  deviceType     RepairDeviceType
  serviceType    RepairServiceType
  issue          String
  diagnosis      String?
  estimate       Decimal?              @db.Decimal(12, 2)
  approvedAmount Decimal?              @db.Decimal(12, 2)
  advanceAmount  Decimal               @default(0) @db.Decimal(12, 2)
  balanceAmount  Decimal               @default(0) @db.Decimal(12, 2)
  technicianId   String?
  promisedDate   DateTime?
  status         RepairStatus          @default(RECEIVED)
  createdById    String
  receivedAt     DateTime              @default(now())
  completedAt    DateTime?
  deliveredAt    DateTime?
  notes          String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  accessories    RepairAccessory[]
  device         RepairDevice?
  images         RepairImage[]
  inspections    RepairInspection[]
  invoice        RepairInvoice?
  branch         Branch                @relation(fields: [branchId], references: [id])
  createdBy      User                  @relation("RepairCreatedBy", fields: [createdById], references: [id])
  customer       Customer?             @relation(fields: [customerId], references: [id])
  technician     User?                 @relation("RepairTechnician", fields: [technicianId], references: [id])
  parts          RepairPart[]
  payments       RepairPayment[]
  statusHistory  RepairStatusHistory[]

  @@unique([branchId, ticketNumber])
  @@index([branchId, status, createdAt])
  @@index([customerId, createdAt])
}

model RepairDevice {
  id              String    @id @default(cuid())
  repairJobId     String    @unique
  brand           String?
  model           String?
  imei            String?
  serialNumber    String?
  ram             String?
  storage         String?
  color           String?
  chargerReceived Boolean   @default(false)
  bagReceived     Boolean   @default(false)
  condition       String?
  passwordNote    String?
  createdAt       DateTime  @default(now())
  repairJob       RepairJob @relation(fields: [repairJobId], references: [id], onDelete: Cascade)

  @@index([serialNumber])
  @@index([imei])
}

model RepairInspection {
  id          String    @id @default(cuid())
  repairJobId String
  item        String
  status      String
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  repairJob   RepairJob @relation(fields: [repairJobId], references: [id], onDelete: Cascade)

  @@unique([repairJobId, item])
  @@index([repairJobId])
}

model RepairAccessory {
  id          String    @id @default(cuid())
  repairJobId String
  name        String
  quantity    Int       @default(1)
  condition   String?
  createdAt   DateTime  @default(now())
  repairJob   RepairJob @relation(fields: [repairJobId], references: [id], onDelete: Cascade)

  @@index([repairJobId])
}

model RepairInvoice {
  id            String        @id @default(cuid())
  branchId      String
  repairJobId   String        @unique
  invoiceNumber String
  subtotal      Decimal       @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  status        InvoiceStatus @default(ISSUED)
  issuedAt      DateTime      @default(now())
  createdAt     DateTime      @default(now())
  branch        Branch        @relation(fields: [branchId], references: [id])
  repairJob     RepairJob     @relation(fields: [repairJobId], references: [id])

  @@unique([branchId, invoiceNumber])
  @@index([branchId, issuedAt])
}

model RepairPart {
  id               String         @id @default(cuid())
  repairJobId      String
  productVariantId String
  quantity         Int
  unitPrice        Decimal        @db.Decimal(12, 2)
  createdAt        DateTime       @default(now())
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  repairJob        RepairJob      @relation(fields: [repairJobId], references: [id], onDelete: Cascade)

  @@index([repairJobId])
  @@index([productVariantId])
}

model RepairPayment {
  id          String    @id @default(cuid())
  branchId    String
  repairJobId String
  amount      Decimal   @db.Decimal(12, 2)
  paymentType String
  paidAt      DateTime  @default(now())
  reference   String?
  createdAt   DateTime  @default(now())
  payment     Payment?
  branch      Branch    @relation(fields: [branchId], references: [id])
  repairJob   RepairJob @relation(fields: [repairJobId], references: [id], onDelete: Cascade)

  @@index([branchId, paidAt])
  @@index([repairJobId, paidAt])
}

model RepairStatusHistory {
  id          String        @id @default(cuid())
  repairJobId String
  oldStatus   RepairStatus?
  newStatus   RepairStatus
  changedById String
  note        String?
  changedAt   DateTime      @default(now())
  changedBy   User          @relation(fields: [changedById], references: [id])
  repairJob   RepairJob     @relation(fields: [repairJobId], references: [id], onDelete: Cascade)

  @@index([repairJobId, changedAt])
}

model Attachment {
  id           String         @id @default(cuid())
  productId    String?
  url          String
  publicId     String?
  fileName     String
  mimeType     String
  bytes        Int
  type         AttachmentType
  uploadedById String
  createdAt    DateTime       @default(now())
  product      Product?       @relation(fields: [productId], references: [id])
  uploadedBy   User           @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id])
  repairImages RepairImage[]

  @@index([productId])
  @@index([type, createdAt])
}

model RepairImage {
  id           String     @id @default(cuid())
  repairJobId  String
  attachmentId String
  caption      String?
  createdAt    DateTime   @default(now())
  attachment   Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  repairJob    RepairJob  @relation(fields: [repairJobId], references: [id], onDelete: Cascade)

  @@unique([repairJobId, attachmentId])
  @@index([repairJobId, createdAt])
}

model EMITransaction {
  id                   String       @id @default(cuid())
  branchId             String
  saleId               String       @unique
  paymentId            String       @unique
  customerId           String
  serialDeviceId       String
  provider             String
  applicationReference String?
  financedAmount       Decimal      @db.Decimal(12, 2)
  tenureMonths         Int?
  emiAmount            Decimal?     @db.Decimal(12, 2)
  status               EMIStatus    @default(PENDING)
  settlementAmount     Decimal?     @db.Decimal(12, 2)
  settlementDate       DateTime?
  notes                String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  branch               Branch       @relation(fields: [branchId], references: [id])
  customer             Customer     @relation(fields: [customerId], references: [id])
  payment              Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  sale                 Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  serialDevice         SerialDevice @relation(fields: [serialDeviceId], references: [id])

  @@index([branchId, createdAt])
  @@index([customerId, createdAt])
  @@index([status, createdAt])
}

model ExpenseCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  expenses  Expense[]
}

model Expense {
  id          String          @id @default(cuid())
  branchId    String
  categoryId  String
  amount      Decimal         @db.Decimal(12, 2)
  description String?
  expenseDate DateTime
  createdById String
  createdAt   DateTime        @default(now())
  branch      Branch          @relation(fields: [branchId], references: [id])
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
  createdBy   User            @relation("ExpenseCreatedBy", fields: [createdById], references: [id])

  @@index([branchId, expenseDate])
  @@index([categoryId, expenseDate])
}

model Transaction {
  id          String          @id @default(cuid())
  branchId    String
  type        TransactionType
  referenceId String?
  referenceNo String?
  amount      Decimal         @db.Decimal(12, 2)
  note        String?
  createdAt   DateTime        @default(now())
  branch      Branch          @relation(fields: [branchId], references: [id])

  @@index([branchId, createdAt])
  @@index([type, createdAt])
  @@index([referenceId])
}

model AuditLog {
  id         String   @id @default(cuid())
  branchId   String?
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  beforeData Json?
  afterData  Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])
  branch     Branch?  @relation(fields: [branchId], references: [id])

  @@index([branchId, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

model WhatsAppMessage {
  id           String         @id @default(cuid())
  branchId     String
  customerId   String?
  sentById     String?
  toPhone      String
  messageType  String
  body         String?
  mediaUrl     String?
  providerId   String?
  status       WhatsAppStatus @default(QUEUED)
  errorMessage String?
  createdAt    DateTime       @default(now())
  sentAt       DateTime?
  branch       Branch         @relation(fields: [branchId], references: [id])
  customer     Customer?      @relation(fields: [customerId], references: [id])
  sentBy       User?          @relation("WhatsAppSentBy", fields: [sentById], references: [id])

  @@index([branchId, createdAt])
  @@index([customerId, createdAt])
  @@index([status, createdAt])
}

model NotificationOutbox {
  id          String             @id @default(cuid())
  branchId    String?
  createdById String?
  type        String
  payload     Json
  status      NotificationStatus @default(QUEUED)
  attempts    Int                @default(0)
  availableAt DateTime           @default(now())
  processedAt DateTime?
  lastError   String?
  createdAt   DateTime           @default(now())
  branch      Branch?            @relation(fields: [branchId], references: [id])
  createdBy   User?              @relation("NotificationCreatedBy", fields: [createdById], references: [id])

  @@index([status, availableAt])
  @@index([branchId, createdAt])
}

